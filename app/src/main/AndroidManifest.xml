<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Usage Access: required to detect the foreground app (opened/closed events).
         Granted by the user in system Settings > Usage Access (not a runtime dialog). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Restricted permission: App Picker calls PackageManager.getInstalledApplications and filters launchable apps.
         Required by core app-target selection; distribution owner must complete Play declaration/review. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Notification permission (Android 13+) for the engine's ongoing status notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Notification Policy Access for Do Not Disturb toggle. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Set alarms and timers via Clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Normal permission for user-configured vibration actions. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Internet permission for HTTP webhook actions. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- NFC hardware and tag discovery -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-permission android:name="android.permission.NFC" />

    <!-- Motion / Flip sensor triggers -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.proximity" android:required="false" />

    <!-- Camera flash for torch action -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- Wi-Fi state and network state permissions -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location permissions: Wi-Fi SSID selection/state and optional GPS coordinates for user rules.
         Background access is needed only when active automations acquire coordinates while app is not visible. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Bluetooth device triggers use bonded-device ACL broadcasts only. No discovery or scan history. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Phone call triggers (TelephonyManager state transitions) and direct call actions. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Restricted permissions: incoming SMS triggers and user-configured direct SMS actions. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Foreground service keeps user-started event monitoring and scheduled automations alive. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Restart the engine after reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Battery optimization exemption so the engine isn't killed. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Modify system settings (WRITE_SETTINGS) for system settings toggles like Auto-rotate. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Toggle Battery Saver / other secure settings.
         protectionLevel is "signature|privileged|development", so it can be granted
         via `adb shell pm grant` (or via Shizuku). Declared so the grant is possible. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".FlowPilotApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlowPilot"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FlowPilot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Shizuku v13+: grant dialog is started as an activity via this filter. -->
            <intent-filter>
                <action android:name="moe.shizuku.manager.intent.action.REQUEST_PERMISSION" />
            </intent-filter>
            <!-- NFC Tag Discovery: default activity launch when tag is tapped while app is not foreground -->
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Automation engine foreground service (special use and location). -->
        <service
            android:name=".engine.AutomationService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs user-started automation monitoring and scheduled rules, including foreground-app transitions, broadcasts, sensors, NFC, calls, SMS, and optional background GPS acquisition." />
        </service>

        <!-- Restart engine after reboot. -->
        <receiver
            android:name=".engine.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- SMS receiver for incoming SMS triggers. -->
        <receiver
            android:name=".engine.SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Notification listener service for notification received triggers. -->
        <service
            android:name=".engine.FlowPilotNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Exported by Shizuku contract; INTERACT_ACROSS_USERS_FULL limits bind callers. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- FileProvider for sharing backup and automation JSON files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Quick Settings Tile for FlowPilot engine toggle -->
        <service
            android:name=".quicksettings.FlowPilotTileService"
            android:icon="@drawable/ic_widget_bolt"
            android:label="@string/tile_engine_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Home Screen AppWidget for FlowPilot quick control -->
        <receiver
            android:name=".widget.FlowPilotWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_flowpilot_control_info" />
        </receiver>
        <receiver
            android:name=".widget.FlowPilotWidgetToggleReceiver"
            android:exported="false" />

    </application>

</manifest>
